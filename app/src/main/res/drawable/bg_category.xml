<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape><solid android:color="@color/red_soft" /><corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/rescue_red" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/line" /></shape>
    </item>
</selector>
