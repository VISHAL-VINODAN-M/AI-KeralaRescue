<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <ScrollView android:id="@+id/mainScroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
            android:paddingTop="16dp" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                    android:contentDescription="Kerala Rescue logo" android:src="@drawable/ic_kerala_rescue" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Kerala Rescue" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:id="@+id/networkStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="Checking connection…" android:textColor="@color/green"
                        android:textSize="12sp" android:background="@drawable/bg_network_status"
                        android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                </LinearLayout>
                <Button android:id="@+id/toggleSettingsButton" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="Settings"
                    android:minWidth="0dp" android:padding="0dp" android:text="⚙" android:textColor="@color/ink" android:textSize="20sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:gravity="center" android:text="Are you in danger?"
                android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:text="Press the button below. Help will reach you soon."
                android:textColor="@color/muted" android:textSize="13sp" />

            <FrameLayout android:layout_width="250dp" android:layout_height="250dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
                android:background="@drawable/bg_sos_ring">
                <Button android:id="@+id/sosButton" android:layout_width="164dp" android:layout_height="164dp"
                    android:layout_gravity="center" android:insetTop="0dp" android:insetBottom="0dp"
                    android:padding="0dp" android:backgroundTint="@color/rescue_red"
                    android:contentDescription="Send emergency SOS with my location"
                    android:text="SOS" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold"
                    app:cornerRadius="82dp" android:elevation="6dp" />
            </FrameLayout>
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="center" android:text="Tap once to alert the rescue team."
                android:textColor="@color/ink" android:textSize="14sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="14dp">
                <TextView android:layout_width="42dp" android:layout_height="42dp" android:gravity="center"
                    android:text="⌖" android:textColor="@color/rescue_red" android:textSize="26sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Current location" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/currentLocationInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="Your location will be shared with an SOS when available."
                        android:textColor="@color/muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/activeCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical"
                android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="YOUR RESCUE UPDATE" android:textColor="@color/rescue_red" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/teamStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Waiting for the rescue team…"
                    android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/statusTimeline" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textColor="@color/blue" android:textSize="14sp" />
                <TextView android:id="@+id/helpCountStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="13sp" />
                <LinearLayout android:id="@+id/activeActions" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:orientation="horizontal">
                        <Button android:id="@+id/refreshStatusButton" style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh" />
                        <Button android:id="@+id/cancelEmergencyButton" style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="8dp" android:text="I'm safe" android:textColor="@color/rescue_red" app:strokeColor="@color/red_soft" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:text="Messages" android:textColor="@color/muted" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/messagesView" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingTop="6dp" android:textColor="@color/ink" android:textSize="14sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Message the rescue team"
                            android:inputType="textCapSentences|textMultiLine" android:maxLength="2000" android:minHeight="48dp"
                            android:padding="12dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                        <Button android:id="@+id/sendMessageButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="Send" />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/dismissStatusButton" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end"
                    android:text="Dismiss" android:visibility="gone" />
            </LinearLayout>

            <Button android:id="@+id/toggleRequestButton" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp"
                android:text="Choose an emergency" android:textColor="@color/rescue_red" app:strokeColor="@color/red_soft" />
            <LinearLayout android:id="@+id/requestForm" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical"
                android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Choose the emergency" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:columnCount="3" android:rowCount="2">
                    <TextView android:id="@+id/categoryFire" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:tag="2" android:text="🔥\nFire" android:textColor="@color/ink" android:textSize="14sp" />
                    <TextView android:id="@+id/categoryFlood" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:tag="0" android:text="≋\nFlood" android:textColor="@color/ink" android:textSize="14sp" />
                    <TextView android:id="@+id/categoryQuake" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:text="▧\nEarthquake" android:textColor="@color/ink" android:textSize="14sp" />
                    <TextView android:id="@+id/categoryCrime" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⚑\nCrime" android:textColor="@color/ink" android:textSize="14sp" />
                    <TextView android:id="@+id/categoryAccident" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:tag="1" android:text="⚠\nAccident" android:textColor="@color/ink" android:textSize="14sp" />
                    <TextView android:id="@+id/categoryOther" android:layout_width="0dp" android:layout_height="68dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_category" android:clickable="true" android:focusable="true" android:gravity="center" android:tag="5" android:text="···\nOthers" android:textColor="@color/ink" android:textSize="14sp" />
                </GridLayout>
                <Spinner android:id="@+id/emergencyTypeSpinner" android:layout_width="1dp" android:layout_height="1dp"
                    android:visibility="gone" android:entries="@array/emergency_types" android:theme="@style/ThemeOverlay.KeralaRescue.Spinner" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="Priority" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
                <Spinner android:id="@+id/prioritySpinner" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="5dp" android:entries="@array/emergency_priorities" android:background="@drawable/bg_input"
                    android:paddingStart="10dp" android:paddingEnd="10dp" android:theme="@style/ThemeOverlay.KeralaRescue.Spinner" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="Quick conditions" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/conditionsGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="2dp">
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionInjured" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Injured" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionBleeding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Severe bleeding" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionBreathing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Breathing problem" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionUnconscious" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unconscious" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionChild" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Child involved" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/Widget.KeralaRescue.ConditionChip" android:id="@+id/conditionElderly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Elderly person" android:checkable="true" />
                </com.google.android.material.chip.ChipGroup>
                <EditText android:id="@+id/requestDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:gravity="top"
                    android:hint="Describe the situation or what you need (optional)" android:minHeight="84dp" android:padding="14dp"
                    android:inputType="textCapSentences|textMultiLine" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/peopleCount" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="How many people need help?"
                    android:inputType="number" android:minHeight="48dp" android:padding="14dp"
                    android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/takePhotoButton" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Camera" />
                    <Button android:id="@+id/addImageButton" style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="Gallery" />
                </LinearLayout>
                <ImageView android:id="@+id/imagePreview" android:layout_width="match_parent" android:layout_height="160dp"
                    android:layout_marginTop="8dp" android:contentDescription="Selected photo"
                    android:scaleType="centerCrop" android:visibility="gone" />
                <Button android:id="@+id/sendRequestButton" android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="12dp" android:backgroundTint="@color/blue"
                    android:text="Send request" android:textColor="#FFFFFF" android:textStyle="bold" />
            </LinearLayout>

            <Button android:id="@+id/historyButton" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="View request history" />

            <LinearLayout android:id="@+id/settingsBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/bg_card" android:orientation="vertical"
                android:padding="18dp" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Rescuers use your number to call you back." android:textColor="@color/muted" android:textSize="13sp" />
                <EditText android:id="@+id/phoneNumber" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Your phone number"
                    android:inputType="phone" android:minHeight="48dp" android:padding="12dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/smsNumber" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Emergency SMS number"
                    android:inputType="phone" android:minHeight="48dp" android:padding="12dp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
                <EditText android:id="@+id/backendUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="Server address"
                    android:inputType="textUri" android:minHeight="48dp" android:padding="12dp" android:textColor="@color/ink" android:textColorHint="@color/muted" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="62dp"
        android:background="@color/surface" android:elevation="10dp" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/navMap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:gravity="center" android:text="⌖\nMap" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:id="@+id/navMessages" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:gravity="center" android:text="▤\nMessage" android:textColor="@color/muted" android:textSize="12sp" />
        <TextView android:id="@+id/navSos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:clickable="true" android:focusable="true" android:gravity="center" android:text="▲\nPanic Alert" android:textColor="@color/rescue_red" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
